{
  "name": "shared-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shared-calendar \"node --test tests/rules.integration.js\"",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "firebase-tools": "^14.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.50.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
